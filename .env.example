# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string.
# Local: postgres://app_tracker:<password>@localhost:5432/app_tracker
# Neon: the pooled URL from the Neon dashboard
DATABASE_URL=

# Prototype stand-in for the signed-in user until Auth.js is added.
# Any stable string, e.g. a UUID from: node -e "console.log(crypto.randomUUID())"
DEV_USER_ID=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend (deadline reminder emails)
RESEND_API_KEY=

# Shared secret Vercel Cron sends to the reminder route
CRON_SECRET=
