# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string (use the pooled URL)
DATABASE_URL=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend (deadline reminder emails)
RESEND_API_KEY=

# Shared secret Vercel Cron sends to the reminder route
CRON_SECRET=
